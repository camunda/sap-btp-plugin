    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome against localhost",
            "url": "http://localhost:5001",
            "webRoot": "${workspaceFolder}/fiori-app/webapp",
